{
  "name": "safebox-desktop",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc && vite build && node scripts/native_app_entry_check.mjs",
    "tauri": "bash scripts/safebox_tauri.sh",
    "android:cold-dev": "bash scripts/android_cold_dev.sh",
    "android:icon": "bash scripts/install_android_launcher_icon.sh",
    "android:import": "bash scripts/android_import.sh",
    "android:e2e-prepare": "bash scripts/android_e2e_prepare.sh",
    "android:e2e-idle": "bash scripts/android_e2e_idle_check.sh",
    "android:e2e-log": "bash scripts/android_e2e_log_check.sh",
    "android:compare": "bash scripts/android_compare.sh",
    "android:storage-recover": "bash scripts/android_storage_recover.sh",
    "ios:doctor": "bash scripts/ios_doctor.sh",
    "ios:icon": "bash scripts/install_ios_app_icon.sh",
    "ios:cold-dev": "bash scripts/ios_cold_dev.sh",
    "ios:runtime-status": "bash scripts/ios_runtime_status.sh",
    "ios:sim-run": "bash scripts/ios_simulator_run.sh",
    "ios:ads-install": "bash scripts/install_ios_ads_privacy.sh",
    "ios:ads-check": "bash scripts/ios_ads_runtime_check.sh",
    "ios:open-check": "bash scripts/ios_open_intake_check.sh",
    "ios:share-check": "bash scripts/ios_share_extension_check.sh",
    "ios:cold-open-arm": "bash scripts/ios_cold_open_arm.sh",
    "ios:cold-open-check": "bash scripts/ios_cold_open_check.sh",
    "ios:cold-share-arm": "bash scripts/ios_cold_share_arm.sh",
    "ios:cold-share-check": "bash scripts/ios_cold_share_check.sh",
    "ios:intake-hardening-check": "bash scripts/ios_intake_hardening_check.sh",
    "ios:replay-recovery-check": "bash scripts/ios_replay_recovery_check.sh",
    "ios:evidence-integrity-check": "bash scripts/ios_evidence_integrity_check.sh",
    "ios:evidence-lifecycle-check": "bash scripts/ios_evidence_lifecycle_check.sh",
    "ios:evidence-ledger-check": "bash scripts/ios_evidence_ledger_check.sh",
    "ios:evidence-ledger-concurrency-check": "python3 scripts/ios_evidence_ledger_concurrency_check.py",
    "desktop:cross-platform-audit": "python3 scripts/desktop_cross_platform_audit.py",
    "web:foundation-check": "python3 scripts/web_foundation_check.py",
    "web:build": "npm run web:wasm-build && npm run web:ui-build && npm run web:dist-check",
    "web:ui-build": "bash scripts/web_ui_build.sh",
    "web:wasm-build": "bash scripts/web_wasm_build.sh",
    "web:wasm-check": "python3 scripts/web_wasm_contract_check.py",
    "web:dist-check": "python3 scripts/web_dist_check.py",
    "web:preview": "vite preview --host 127.0.0.1 --port 4173",
    "web:lock-check": "bash scripts/web_cargo_lock_sync.sh",
    "web:production-check": "python3 scripts/web_production_check.py",
    "web:e2e": "bash scripts/web_browser_e2e.sh",
    "web:serve-prod": "python3 scripts/web_prod_server.py",
    "web:production-gate": "npm run web:build && npm run web:production-check && npm run web:e2e",
    "web:deployment-check": "python3 scripts/web_deployment_check.py",
    "web:deploy-bundle": "python3 scripts/web_deploy_bundle.py",
    "web:remote-audit": "python3 scripts/web_remote_audit.py",
    "web:release-gate": "npm run web:production-gate && npm run web:experience-check && npm run web:deployment-check && npm run web:deploy-bundle",
    "web:experience-check": "python3 scripts/web_experience_check.py"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "typescript": "7.0.2",
    "vite": "8.1.3"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.24"
  }
}
