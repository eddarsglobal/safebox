# ============================================================
# SAFEBOX / SBX — Git ignore
# Keep source, documentation, QA reports and scripts in Git.
# In particular: .md, .txt and .sh files are NOT globally ignored.
# ============================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# ------------------------------------------------------------
# Secrets / local environment
# ------------------------------------------------------------
.env
.env.*
!.env.example

*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# Local credentials / signing material
credentials/
secrets/
private/
*.mobileprovision

# ------------------------------------------------------------
# JavaScript / TypeScript / Vite
# ------------------------------------------------------------
node_modules/
dist/
.vite/
coverage/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------
# Rust / Cargo / Tauri
# ------------------------------------------------------------
target/
**/target/

# ------------------------------------------------------------
# Android / Gradle
# ------------------------------------------------------------
.gradle/
**/.gradle/
local.properties
*.apk
*.aab
*.ap_
*.dex

# Build directories generated by Android tooling
**/build/

# ------------------------------------------------------------
# iOS / Xcode
# ------------------------------------------------------------
DerivedData/
xcuserdata/
*.xcuserstate
Pods/

# ------------------------------------------------------------
# IDE / editor local files
# ------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~

# ------------------------------------------------------------
# Temporary files / logs / caches
# ------------------------------------------------------------
*.log
*.tmp
*.temp
*.cache
.cache/
tmp/
temp/

# ------------------------------------------------------------
# SAFEBOX historical/local backup files
# ------------------------------------------------------------
*.backup
*.backup-*
*.bak
*.orig

# ------------------------------------------------------------
# Archives / packaged release artifacts generated locally
# ------------------------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz

# ------------------------------------------------------------
# IMPORTANT — intentionally tracked
# ------------------------------------------------------------
# Do NOT add global rules for:
# *.md   -> documentation, checkpoints, audit/release reports
# *.txt  -> release/package identifiers and useful project text
# *.sh   -> development, patch and verification scripts
#
# SAFEBOX folders such as checkpoints/ and verification/
# remain tracked unless a specific generated subfolder is later
# identified as disposable.
